[Unit]
Description=Pyrocene cinematic prototype on 8021
PartOf=pyrocene-games.target

[Service]
Type=simple
WorkingDirectory=%h/src/github.com/bprashanth/pyrocene
ExecStart=/usr/bin/python3 -u -m http.server 8021 --bind 0.0.0.0 --directory /mnt/seagate/videos/pyrocene/prototypes
Restart=on-failure
RestartSec=3
